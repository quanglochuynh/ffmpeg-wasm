{
  "name": "@locqhuynh/ffmpeg-wasm",
  "version": "0.1.0-alpha",
  "description": "Read video metadata and extract JPEG frames with FFmpeg and WebAssembly",
  "license": "(MIT AND LGPL-2.1-or-later)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quanglochuynh/ffmpeg-wasm.git"
  },
  "homepage": "https://github.com/quanglochuynh/ffmpeg-wasm#readme",
  "bugs": {
    "url": "https://github.com/quanglochuynh/ffmpeg-wasm/issues"
  },
  "keywords": [
    "ffmpeg",
    "wasm",
    "webassembly",
    "video",
    "metadata"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build:wasm": "bash scripts/build.sh",
    "build:ts": "tsc",
    "build": "bash -c 'source ../emsdk/emsdk_env.sh && pnpm build:wasm && pnpm build:ts'",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
